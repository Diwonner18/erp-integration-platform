            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"acao\": \"OBRA_CRIADA_AUTOMATICAMENTE\",\n  \"entidade\": \"obras\",\n  \"entidade_id\": \"{{ $('Gerar Checklist').first().json.obra.id }}\",\n  \"dados\": {{ JSON.stringify($('Gerar Checklist').first().json.obra) }},\n  \"origem\": \"n8n-wf-01\",\n  \"created_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "registrar-audit",
      "name": "Registrar Audit Log",
      "type": "n8n-nodes-base.httpRequest",
