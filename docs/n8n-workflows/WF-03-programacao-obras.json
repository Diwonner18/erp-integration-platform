        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"programada\",\n  \"ultima_programacao\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "atualizar-status-obra",
      "name": "Atualizar Status Obra",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_SUA_CREDENCIAL",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Programação criada com sucesso\",\n  \"programacao\": {{ JSON.stringify($('Preparar Notificações').first().json.programacao) }},\n  \"notificacoes_enviadas\": {{ $('Preparar Notificações').first().json.notificacoes.length }}\n}",
        "options": {}
      },
